{
  "name": "aipura-score-calc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IDOLY PRIDE (JP) live score calculator - pure-function calc core",
  "scripts": {
    "test": "vitest run",
    "simulate": "npx -y tsx src/cli/simulate.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc --noEmit -p ui",
    "build:data": "node tools/importers/build_data.mjs",
    "build:ui": "node tools/build_ui.mjs",
    "solve:t5": "npx -y tsx tools/t5_solver.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
